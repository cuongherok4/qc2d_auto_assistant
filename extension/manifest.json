{
  "manifest_version": 3,
  "name": "M13 Review Queue",
  "version": "0.3.0",
  "description": "Review QC 2D theo hàng đợi, mở CVAT và lưu verdict.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "background": {"service_worker": "background.js"},
  "action": {"default_title": "Mở/đóng QC", "default_icon": {"16":"icon16.png","32":"icon32.png","48":"icon48.png","128":"icon128.png"}},
  "icons": {"16":"icon16.png","32":"icon32.png","48":"icon48.png","128":"icon128.png"},
  "content_scripts": [{"matches": ["http://localhost/tasks/*", "http://127.0.0.1/tasks/*"], "js": ["content.js"], "run_at":"document_idle"}],
  "web_accessible_resources": [{"resources":["sidepanel.html","sidepanel.js","sidepanel.css","logo.svg"],"matches":["http://localhost/*","http://127.0.0.1/*"]}],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'self'"}
}
